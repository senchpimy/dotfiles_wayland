import QtQuick
import QtQuick.Layouts
import QtQuick.Controls // Usaremos Controls básicos
import Quickshell.Wayland
import Qt5Compat.GraphicalEffects
import QtQuick.Window // Para Screen.height

Item {
    id: root
    required property LockContext context
    // readonly property ColorGroup colors: Window.active ? palette.active : palette.inactive // Simplificado

    // --- Propiedades de Estilo y Animación ---
    property color textColor: "white"
    property color textShadowColor: "#50000000"
    property int blurRadius: 60
    property int blurSamples: 30
    property int animationDuration: 300
    // property bool showingAuth: false // Ya no es necesario
    property real contentOpacity: 0
    // property real authAreaOpacity: 0 // Ya no es necesario, se controla con contentOpacity

    // --- Fondo ---
    Loader {
        id: strLoad
        source: "ImagePath.qml"
    }

    Item {
        id: backgroundLayer
        anchors.fill: parent

        Image {
            id: backgroundImage
            source: strLoad.item ? strLoad.item.path : ""
            anchors.fill: parent
            fillMode: Image.PreserveAspectCrop
            visible: false
        }

        GaussianBlur {
            anchors.fill: backgroundImage
            source: backgroundImage
            radius: root.blurRadius
            samples: root.blurSamples
            // cached: true // Considera si el fondo no cambia
        }

        Rectangle { // Overlay oscuro sutil
            anchors.fill: parent
            color: "#30000000"
            visible: backgroundLayer.visible
        }
    }

    // --- Contenido Principal (Reloj, Fecha, etc.) ---
    Item {
        id: mainContent
        anchors.fill: parent
        opacity: root.contentOpacity // Controlado por animación de entrada/salida

        // Fecha
        Label {
            id: dateLabel
            font.family: "Roboto, Noto Sans, Cantarell, Sans-Serif"
            font.pointSize: 16
            font.weight: Font.Normal
            color: root.textColor
            anchors {
                horizontalCenter: parent.horizontalCenter
                bottom: clockLabel.top
                bottomMargin: 5
            }
            property var date: new Date()
             Timer {
                 interval: 60000; repeat: true; running: true
                 onTriggered: { var now = new Date(); if (now.getDate() !== dateLabel.date.getDate()) dateLabel.date = now; }
             }
            text: dateLabel.date.toLocaleDateString(Qt.locale(), "dddd, d 'de' MMMM")
            layer.enabled: true
            layer.effect: DropShadow { horizontalOffset: 1; verticalOffset: 1; radius: 3.0; samples: 5; color: root.textShadowColor; spread: 0.1 }
        }

        // Reloj
        Label {
            id: clockLabel
            font.family: "Roboto, Noto Sans, Cantarell, Sans-Serif"
            font.pointSize: 80
            font.weight: Font.Thin
            color: root.textColor
            anchors {
                horizontalCenter: parent.horizontalCenter
                verticalCenter: parent.verticalCenter
                verticalCenterOffset: -parent.height * 0.15
            }
            property var date: new Date()
            Timer { interval: 1000; repeat: true; running: true; onTriggered: clockLabel.date = new Date() }
            text: clockLabel.date.toLocaleTimeString(Qt.locale(), "hh:mm")
            layer.enabled: true
            layer.effect: DropShadow { horizontalOffset: 1; verticalOffset: 2; radius: 4.0; samples: 7; color: root.textShadowColor; spread: 0.1 }
        }

        // --- Controles Multimedia (Si están activos) ---
        MediaControls {
             id: mediaControls
             player: "spotify"
             anchors {
                 top: clockLabel.bottom
                 horizontalCenter: parent.horizontalCenter
                 topMargin: 40
                 //width: Math.min(parent.width * 0.8, 400)
             }
             visible: playbackStatus !== MediaControls.NoMedia
             opacity: visible ? 1 : 0
             Behavior on opacity { NumberAnimation { duration: root.animationDuration } }
         }


        // --- Área de Autenticación (Huella y Contraseña) ---
        // Ahora siempre visible y parte del flujo normal
        ColumnLayout {
            id: authArea
            anchors {
                horizontalCenter: parent.horizontalCenter
                bottom: parent.bottom
                bottomMargin: 80 // Ajusta según necesites
            }
            // opacity: root.authAreaOpacity // Controlado por mainContent.opacity ahora
            // visible: root.showingAuth // Ya no se controla así, siempre visible con mainContent
            spacing: 15

            // Icono/Mensaje Huella
            Huella {
                 id: huellaComponent
                 func: root.context
                 // visible: context.fingerprintAvailable // Mostrar solo si hay huella
            }
            /*
            Label { // Alternativa si Huella es solo lógica
                text: "Touch ID o introduce el código"
                color: root.textColor
                font.pointSize: 14
                visible: context.fingerprintAvailable
            }
            */

            // Campo de Contraseña
            TextField {
                id: passwordBox
                implicitWidth: 250
                padding: 12
                font.pointSize: 16
                color: root.textColor
                placeholderText: "Introduce el código"
                placeholderTextColor: Qt.lighter(root.textColor, 1.5)

                // focus: false // No enfocar automáticamente al cargar la pantalla
                enabled: !root.context.unlockInProgress // Habilitado a menos que esté en proceso de desbloqueo
                echoMode: TextInput.Password
                inputMethodHints: Qt.ImhSensitiveData | Qt.ImhNoPredictiveText

                onTextChanged: root.context.currentText = text
                onAccepted: root.context.tryUnlock()
                Connections {
                    target: root.context
                    function onCurrentTextChanged() {
                        if (passwordBox.text !== root.context.currentText) {
                           passwordBox.text = root.context.currentText;
                        }
                    }
                }

                background: Rectangle {
                    color: "#60FFFFFF"
                    radius: 8
                    border.width: 0
                }

                // cursorVisible: text.length > 0 || activeFocus // Mostrar cursor si tiene texto o foco activo
                // Quitar el timer para ocultar cursor, comportamiento estándar está bien
            }

            // Mensaje de Error
            Label {
                id: errorLabel
                visible: root.context.showFailure // Visible solo si hay error
                text: "Código incorrecto"
                color: "#FF8888"
                font.pointSize: 14
                anchors.horizontalCenter: parent.horizontalCenter
            }
        }

        // --- Indicador "Deslizar para desbloquear" ---
        // Eliminado

    } // Fin de mainContent

    // --- Área de Interacción para Deslizar ---
    // Eliminada


    // --- Animaciones ---

    // Animación de Entrada (Fade-in de todo el contenido)
    NumberAnimation {
        target: root
        property: "contentOpacity"
        from: 0
        to: 1
        duration: 600
        easing.type: Easing.OutCubic
        running: true
    }

    // --- Animaciones para mostrar/ocultar authArea eliminadas ---


    // --- Conexiones con el Contexto ---
    Connections {
        target: root.context
        function onUnlockInProgressChanged() {
             passwordBox.enabled = !root.context.unlockInProgress; // Habilitar/deshabilitar basado en el progreso
        }
        function onShowFailureChanged() {
             errorLabel.visible = root.context.showFailure; // Visibilidad del error
        }
        function onUnlocked() {
             console.log("Unlocked signal received!");
             unlockAnimation.start();
        }
    }

    // Animación de Salida (Fade-out al desbloquear)
    NumberAnimation {
         id: unlockAnimation
         target: root // O mainContent
         property: "contentOpacity"
         from: 1
         to: 0
         duration: root.animationDuration
         easing.type: Easing.InCubic
         // running: false // Se inicia desde onUnlocked
    }

    Component.onCompleted: {
        console.log("Lock screen loaded (no swipe prompt).");
        // Ya no se fuerza el foco en passwordBox
    }
}
